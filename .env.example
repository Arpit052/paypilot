# Copy this file to .env and fill in your keys.

# ---- PayPal (https://developer.paypal.com → Apps & Credentials → Sandbox) ----
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# sandbox (default when keys are set) | mock (offline simulation) | live
PAYPAL_MODE=sandbox
# Optional: Webhook ID from your sandbox app (needed to receive "invoice paid" events)
PAYPAL_WEBHOOK_ID=

# ---- AI: set ONE of these ----
# Google Gemini (free key from aistudio.google.com) - uses Gemini's native API
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# thinking level: low | medium | high | off
GEMINI_REASONING=low
# tried in order when the main model is busy or rate-limited
GEMINI_FALLBACK_MODELS=gemini-3.5-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite

# Claude (Anthropic)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# ...or any OpenAI-compatible API (OpenAI, Gemini, Groq, OpenRouter, local)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# ---- App ----
# Require a passcode to open the app (recommended when hosted publicly)
APP_PASSWORD=
# Time zone for "today" and due dates (default: this computer's time zone)
APP_TIMEZONE=
# Sales tax % used when none is given
DEFAULT_TAX_PERCENT=0
# Background jobs (PayPal sync, overdue reminders, recurring invoices) every N minutes; 0 = off
SCHEDULER_INTERVAL_MIN=360
BUSINESS_NAME=Northline Studio
DEFAULT_CURRENCY=USD
PORT=3000
# Days to wait before drafting another reminder for the same invoice
REMINDER_COOLDOWN_DAYS=3
# Secret for the scheduled follow-up endpoint: GET /api/cron/followups?key=...
CRON_SECRET=
# Demo helper: shift the app's clock forward N days so sent invoices become overdue
DEMO_TIME_OFFSET_DAYS=0
